* text=auto

*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.npy binary
*.npz binary
*.pt binary
*.pth binary
*.ckpt binary
*.onnx binary
*.ttf binary
*.otf binary
*.ttc binary

# Versioned datasets managed by Git LFS
data/datasets/**/*.png filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.bmp filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.npy filter=lfs diff=lfs merge=lfs -text
data/datasets/**/*.npz filter=lfs diff=lfs merge=lfs -text
